<!--
  STOOGE static analysis - shared MSBuild settings.
  Copyright (c) eroman53 2026. Licensed under the GNU GPL v3; see LICENSE.

  Canonical copy lives in openrmf-docs/code-analysis/Directory.Build.props.
  install-analysis.ps1 copies this file (and stooge.editorconfig -> .editorconfig)
  to the root of every in-scope service repo. Edit the canonical copy, re-run the
  installer; do not hand-edit the copies or they drift.

  AnalysisMode=None turns every analyzer rule off, and .editorconfig then names
  the rules we want one at a time. That makes the ruleset an allow-list: nothing
  fires unless it is listed, and an SDK upgrade cannot quietly add hundreds of
  warnings to everyone's build.

  It has to be done per-rule. The SDK implements AnalysisMode by injecting a
  generated .globalconfig with an explicit severity line for every rule in the
  catalog, and Roslyn resolves explicit per-rule entries ahead of any bulk or
  category-wide entry. The tidy "dotnet_analyzer_diagnostic.severity = none" and
  "...category-Security.severity = error" forms therefore parse fine and do
  nothing at all. Measured, not assumed. See the header of stooge.editorconfig.
-->
<Project>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>None</AnalysisMode>

    <!-- Ratchet, do not gate. Analyzer findings surface as warnings and in the
         report; only the rules explicitly marked "error" in .editorconfig stop a
         build, and those were chosen because the tree is already clean of them.
         Flipping this to true would fail every build in the fork today. -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Code *style* (IDE####) is formatting, not analysis. Left off on purpose:
         it would bury the security findings this ruleset exists to surface. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Analyzers are a build-time concern only; never ship them in the image. -->
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <!-- Test projects get the same rules; nothing to vary yet, kept as a seam. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
  </PropertyGroup>
</Project>
