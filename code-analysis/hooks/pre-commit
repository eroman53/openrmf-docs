#!/usr/bin/env bash
# STOOGE pre-commit static analysis hook.
# Copyright (c) eroman53 2026. Licensed under the GNU GPL v3; see LICENSE.
#
# Installed into each service repo's .git/hooks/ by install-analysis.ps1.
# Builds the repo being committed with the Roslyn analyzers enabled and blocks
# the commit if any rule in the "error" tier fires (see .editorconfig: that tier
# is the analyzers' Security category, minus documented exceptions). Warnings
# are printed and never block -- the ruleset ratchets, it does not gate.
#
# Caveat worth knowing: like every build-based hook, this analyzes the WORKING
# TREE, not the staged index. Partially staged changes are analyzed as they sit
# on disk, not as they would land in the commit.
#
# Escape hatches:
#   STOOGE_SKIP_ANALYSIS=1 git commit ...   # skip just this hook
#   git commit --no-verify ...              # skip all hooks
#
# Override the tooling location if the checkouts are not siblings:
#   STOOGE_ANALYSIS_HOME=/path/to/openrmf-docs/code-analysis

set -u

if [ "${STOOGE_SKIP_ANALYSIS:-0}" = "1" ]; then
    echo "stooge: static analysis skipped (STOOGE_SKIP_ANALYSIS=1)"
    exit 0
fi

# Nothing to analyze unless C# or project files are staged.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! echo "$staged" | grep -qiE '\.(cs|csproj|props|editorconfig)$'; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
repo_name=$(basename "$repo_root")

home="${STOOGE_ANALYSIS_HOME:-$(dirname "$repo_root")/openrmf-docs/code-analysis}"
script="$home/stooge-analyze.ps1"
if [ ! -f "$script" ]; then
    echo "stooge: analysis driver not found at $script" >&2
    echo "        set STOOGE_ANALYSIS_HOME to the code-analysis folder, or commit with --no-verify." >&2
    exit 1
fi

pwsh_bin=$(command -v pwsh || command -v powershell || true)
if [ -z "$pwsh_bin" ]; then
    echo "stooge: neither pwsh nor powershell is on PATH; cannot run static analysis" >&2
    exit 1
fi

echo "stooge: running static analysis on $repo_name ..."
"$pwsh_bin" -NoProfile -NonInteractive -File "$script" \
    -Repo "$repo_name" \
    -SourceRoot "$(dirname "$repo_root")" \
    -PreCommit -Incremental
rc=$?

if [ $rc -ne 0 ]; then
    echo ""
    echo "stooge: COMMIT BLOCKED -- the build failed or an error-tier analyzer rule fired." >&2
    echo "        Fix the reported diagnostics, or commit with --no-verify if this is a" >&2
    echo "        deliberate exception that you will document." >&2
    exit $rc
fi

exit 0
