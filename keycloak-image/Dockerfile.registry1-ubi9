# syntax=docker/dockerfile:1.7
# Private local build from a digest-pinned Registry1 Keycloak 26.8.1 image.
# The upstream distribution already includes the corrected Netty, Bouncy Castle,
# Jackson, and FreeMarker dependencies; do not copy the old 26.7.4 JAR overlay.
ARG STOOGE_KEYCLOAK_BASE
ARG STOOGE_UBI_BASE

FROM ${STOOGE_KEYCLOAK_BASE} AS builder
ENV KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_HTTP_ENABLED=true \
    KC_HTTP_PORT=8080 \
    KC_HOSTNAME_STRICT=false \
    PROXY_ADDRESS_FORWARDING=true \
    KC_HTTP_RELATIVE_PATH=/auth \
    KC_DB=postgres
USER 1000
COPY ./themes/openrmf/ /opt/keycloak/themes/openrmf/
COPY ./themes/stooge/ /opt/keycloak/themes/stooge/
RUN case "$(/opt/keycloak/bin/kc.sh --version)" in *26.8.1*) ;; *) exit 1 ;; esac \
 && test -f /opt/keycloak/lib/lib/main/io.netty.netty-handler-4.1.138.Final.jar \
 && test -f /opt/keycloak/lib/lib/main/org.bouncycastle.bcprov-jdk18on-1.86.jar \
 && test -f /opt/keycloak/lib/lib/main/org.bouncycastle.bcpkix-jdk18on-1.86.jar \
 && test -f /opt/keycloak/lib/lib/main/org.bouncycastle.bcutil-jdk18on-1.86.jar \
 && test -f /opt/keycloak/lib/lib/main/com.fasterxml.jackson.core.jackson-core-2.21.7.jar \
 && test -f /opt/keycloak/lib/lib/main/com.fasterxml.jackson.core.jackson-databind-2.21.7.jar \
 && test -f /opt/keycloak/lib/lib/main/org.freemarker.freemarker-2.3.35.jar \
 && /opt/keycloak/bin/kc.sh build --spi-x509cert-lookup-provider=nginx

FROM ${STOOGE_UBI_BASE} AS keydb
USER 0
COPY --from=builder /var/lib/rpm/ /var/lib/rpm/
COPY --from=builder /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release /tmp/RPM-GPG-KEY-redhat-release
RUN rpm --import /tmp/RPM-GPG-KEY-redhat-release \
 && rpm -q gpg-pubkey \
 && printf '%s\n' \
      'cipher@SSH=AES-256-GCM AES-256-CTR AES-128-GCM AES-128-CTR' \
      'mac@SSH=HMAC-SHA2-512 HMAC-SHA2-256' \
      > /etc/crypto-policies/policies/modules/STIG.pmod \
 && update-crypto-policies --no-reload --set FIPS:STIG

FROM ${STOOGE_KEYCLOAK_BASE}
USER 0
COPY --from=keydb /var/lib/rpm/ /var/lib/rpm/
COPY --from=keydb /etc/crypto-policies/ /etc/crypto-policies/
COPY --from=builder /opt/keycloak/ /opt/keycloak/
RUN sed -i 's/umask 022/umask 077/g' /etc/bashrc \
 && printf '%s\n' 'umask 077' >> /etc/profile
USER 1000
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
