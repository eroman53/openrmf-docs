# Copy this file to .env in the same folder, then edit it for your host:
#
#   cp .env.example .env
#
# .env is NOT tracked by git in this fork, because it holds per-deployment
# values and at least one secret. .env.example is the tracked template.
#
# Compose reads .env from this folder for two different jobs: it sets variables
# inside containers (env_file:) AND it resolves ${...} references in
# docker-compose.yml. Both matter, which is why these live in one file rather
# than an overlay.

COMPOSE_IGNORE_ORPHANS=True

# The IP or DNS name of THIS host, the way browsers and containers reach it.
# Do not use localhost or 127.0.0.1: inside a container that means the
# container itself. Add the in-network Keycloak name as a second entry so
# services can validate tokens without leaving the Docker network.
JWTAUTHORITY=http://xxx.xxx.xxx.xxx:8080/auth/realms/openrmf,http://openrmf-keycloak:8080/auth/realms/openrmf
JWTCLIENT=openrmf

# SECRET. Keycloak client secret for the openrmf-scanwatch service account,
# used by the scan-watch and Trivy services to upload as themselves. Generate
# it in Keycloak (clients > openrmf-scanwatch > credentials) and paste here.
SCANWATCH_CLIENTSECRET=

# The folder tree the Trivy scanner mounts read-only at /target. Either a host
# path, or "trivyscan-nfs" to use the NFS export defined in docker-compose.yml.
# Leave unset to fall back to the empty trivyscan-target-volume.
TRIVYSCAN_TARGET=
