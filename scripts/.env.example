# Copy to scripts/.env and replace every placeholder with a unique secret.
# Do not commit scripts/.env.
COMPOSE_IGNORE_ORPHANS=true
STOOGE_IMAGE_TAG=v0.9.0-rc.1
STOOGE_KEYCLOAK_IMAGE_TAG=26.7.4-p1-v0.9.0-rc.1
MONGO_ROOT_USERNAME=replace-me
MONGO_ROOT_PASSWORD=replace-me
MONGO_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me
KEYCLOAK_ADMIN=replace-me
KEYCLOAK_ADMIN_PASSWORD=replace-me
STOOGE_INITIAL_ADMIN_USERNAME=replace-me
STOOGE_INITIAL_ADMIN_PASSWORD=replace-me
SCANWATCH_CLIENTSECRET=replace-me
JWTAUTHORITY=https://stooge.example.mil/auth/realms/openrmf
# Local installs: run scripts/set-local-auth.ps1 against the initialized stack
# to add localhost issuers AND matching Keycloak client redirects; see LOCAL-AUTH.md.
JWTCLIENT=openrmf
CORSORIGINS=https://stooge.example.mil
TRIVYSCAN_TARGET=trivyscan-target-volume
